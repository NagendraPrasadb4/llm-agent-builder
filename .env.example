# Copy to .env and fill in. All keys are optional — the repo runs fully offline
# with MockProvider (used by tests, demo, and eval) when no keys are set.

# Provider API keys (at least one needed for live LLM calls)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model selection (defaults shown)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash

# Failover order: first provider tried, then the next on failure
PROVIDER_ORDER=openai,anthropic,gemini

# Agent behaviour
AGENT_MAX_STEPS=8
RAG_TOP_K=4
